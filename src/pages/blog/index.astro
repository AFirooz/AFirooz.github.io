---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { profile } from '../../data/resume';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const description = 'Notes on AI engineering, data, and cloud infrastructure.';
---

<Base title={`Blog · ${profile.name}`} description={description} ogType="website">
  <main id="main" class="wrap page">
    <header class="page-head">
      <span class="icon-tile"><Icon name="pen" /></span>
      <h1>Blog</h1>
      <p class="page-lead">{description}</p>
    </header>

    {
      posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <PostCard post={post} heading="h2" />
          ))}
        </div>
      ) : (
        <p class="muted">Nothing published yet.</p>
      )
    }
  </main>
</Base>
