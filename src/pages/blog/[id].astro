---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/resume';
import { getPosts, postUrl, readingTime, formatDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts are newest first, so the "next" (newer) post is the one before.
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  keywords: tags.join(', '),
  url: new URL(postUrl(post), Astro.site).href,
  author: { '@type': 'Person', name: profile.name, url: profile.site },
};
---

<Base title={`${title} · ${profile.name}`} description={description} ogType="article" jsonLd={jsonLd}>
  <main id="main" class:list={['wrap', 'post-layout', { 'has-toc': toc.length > 1 }]}>
    <article class="post">
      <a class="back mono" href="/blog/">← All posts</a>
      <header class="post-head">
        <p class="post-meta mono">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post)}</span>
          {updated && <span>· updated {formatDate(updated)}</span>}
          {draft && <span class="badge draft">Draft, not published</span>}
        </p>
        <h1>{title}</h1>
        <p class="post-lead">{description}</p>
        {
          tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="md" data-post-body>
        <Content />
      </div>

      <nav class="post-nav" aria-label="More posts">
        {
          older ? (
            <a href={postUrl(older)}>
              <span class="mono muted">← Older</span>
              <span>{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="is-next" href={postUrl(newer)}>
              <span class="mono muted">Newer →</span>
              <span>{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <p class="subhead">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class:list={{ 'is-sub': h.depth === 3 }}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </main>
</Base>

<script>
  import '../../scripts/post';
</script>
