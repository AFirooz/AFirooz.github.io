---
import { profile } from '../data/resume';
import { getPosts } from '../lib/posts';

const hasPosts = (await getPosts()).length > 0;
---

<footer class="site-footer">
  <div class="wrap">
    <span>© {new Date().getFullYear()} {profile.name} · <span class="mono">{profile.motto.join(' · ')}</span></span>
    <span class="footer-links">
      {hasPosts && <a href="/rss.xml">RSS</a>}
      <a href={profile.repo} target="_blank" rel="noopener">Source on GitHub</a>
    </span>
  </div>
</footer>
