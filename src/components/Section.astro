---
import Icon from './Icon.astro';

interface Props {
  id: string;
  icon: string;
  title: string;
  lead?: string;
}

const { id, icon, title, lead } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`} data-spy>
  <header class="section-head reveal">
    <span class="icon-tile"><Icon name={icon} /></span>
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && <p class="section-lead">{lead}</p>}
  </header>
  <slot />
</section>
